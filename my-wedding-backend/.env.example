# ==============================================================================
# Environment Variables - My Wedding Backend
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://postgres:5432/wedding_db
DB_USER=wedding_user
DB_PASS=your_secure_database_password

# ------------------------------------------------------------------------------
# JWT Security Configuration
# Use strong random strings (min 256 bits / 32 characters)
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=your_jwt_secret_key_min_32_characters_long
JWT_SECRET_TEMPORARY_KEY=your_jwt_temporary_secret_key_min_32_characters

# ------------------------------------------------------------------------------
# Email Configuration (SMTP)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FORM_ORIGIN=https://yourdomain.com

# ------------------------------------------------------------------------------
# CORS Configuration
# Comma-separated list of allowed origins
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

