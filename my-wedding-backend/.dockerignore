# ==============================================================================
# .dockerignore - Optimize Docker build context
# ==============================================================================

# Git
.git
.gitignore
.gitattributes

# IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
*.swp
*.swo

# Build outputs (we build inside Docker)
target/
build/
out/
*.jar
*.war
*.class

# Maven wrapper (we install Maven in Docker)
# Uncomment if you want to use wrapper instead
# .mvn/
# mvnw
# mvnw.cmd

# Logs
*.log
logs/

# Test files
src/test/
*.test.js
*.spec.js

# Documentation
*.md
!README.md
docs/
LICENSE

# Docker files (avoid recursive builds)
Dockerfile*
docker-compose*
.docker/

# Environment and secrets
.env
.env.*
*.pem
*.key
*.crt
secrets/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile
.circleci/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.backup
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Coverage reports
coverage/
*.lcov
.nyc_output/

# Kubernetes manifests (not needed in image)
k8s/
kubernetes/
helm/
charts/

